#!/bin/sh
# Entrada do AppImage: abre o NN Studio (o nn e o nn-jogo ficam ao lado dele).
HERE="$(dirname "$(readlink -f "$0")")"
export PATH="$HERE/usr/bin:$PATH"
# "NN-Studio.AppImage nn ..." roda a ferramenta nn (ex.: nn mcp ~/meu-jogo).
if [ "$1" = "nn" ]; then
  shift
  exec "$HERE/usr/bin/nn" "$@"
fi
exec "$HERE/usr/bin/nn-studio" "$@"
